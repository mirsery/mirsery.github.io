nav.component-nav

    ul
        div.logo-container
            a(href="/")
                h2.title= config.title

        each value, key in theme.menu
            - var re = /^(http|https):\/\/*/gi;
            - var tar = re.test(value) ? "_blank" : "_self"
            - var full_value = value == "/" ? "/index.html": value+"/index.html"
            - var act = !re.test(value) && (url_for(page.path) === full_value)
            - var _key = key.toUpperCase()
            a.li.component-nav-item(href=url_for(value) target=tar)
                p(class={selected: act})
                    !=__(_key)
        ul.shortcut-icons
            each nav_item in theme.nav_icons
                a(href=nav_item[1] target="_blank")
                    img.icon(src=nav_item[0])

//- 页头右上角的浅色/深色切换按钮，点击逻辑在 source/script/theme.js
button.theme-toggle(type="button" aria-label="切换浅色/深色主题" title="切换浅色/深色主题")
    svg.icon-sun(viewBox="0 0 24 24" aria-hidden="true")
